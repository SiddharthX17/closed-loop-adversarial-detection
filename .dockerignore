# Python
venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.mypy_cache/

# Secrets — never in image
.env
*.tfvars
*.tfstate
*.tfstate.backup

# Terraform
terraform/.terraform/
terraform/tfplan

# Dev / docs
.git/
.github/
tests/

# Open the scripts folder, wipe its contents, but keep atomic.yaml
!scripts/
scripts/*
!scripts/fetch_atomic_tests.py


*.docx
*.md
README*

# Corpus attack output — regenerated at runtime, no need to bake in
# (benign corpus is included via corpus/benign/ — needed by noise gate)
corpus/attack/

# Run history — container-specific, starts fresh each deploy
data/run_history.json

# Atomic Red Team git metadata — just need the atomics/ files
data/atomic-red-team/.git/